ed Side Bends',thai:'\u0e17\u0e48\u0e32\u0e01\u0e49\u0e21\u0e02\u0e49\u0e32\u0e07\u0e02\u0e13\u0e30\u0e19\u0e31\u0e48\u0e07',japanese:'\u30b7\u30fc\u30c6\u30c3\u30c9\u30b5\u30a4\u30c9\u30d9\u30f3\u30c9'},"Seated Forward Roll-ups":{eng:'Seated Forward Roll-Ups',thai:'\u0e17\u0e48\u0e32\u0e23\u0e2d\u0e1a\u0e15\u0e31\u0e27\u0e02\u0e13\u0e30\u0e19\u0e31\u0e48\u0e07',japanese:'\u30b7\u30fc\u30c6\u30c3\u30c9\u30d5\u30a9\u30ef\u30fc\u30c9\u30ed\u30fc\u30eb\u30a2\u30c3\u30d7'},"Wood Chops":{eng:'Wood Chops',thai:'\u0e17\u0e48\u0e32\u0e15\u0e31\u0e14\u0e44\u0e21\u0e49',japanese:'\u30a6\u30c3\u30c9\u30c1\u30e7\u30c3\u30d7'},Planks:{eng:'Planks',thai:'\u0e17\u0e48\u0e32\u0e41\u0e1e\u0e25\u0e07\u0e04\u0e4c',japanese:'\u30d7\u30e9\u30f3\u30af'},"Wall Planks":{eng:'Wall Planks',thai:'\u0e17\u0e48\u0e32\u0e41\u0e1e\u0e25\u0e07\u0e04\u0e4c\u0e1c\u0e19\u0e31\u0e07',japanese:'\u30a6\u30a9\u30fc\u30eb\u30d7\u30e9\u30f3\u30af'},"Single Limb Stance":{eng:'Single Limb Stance',thai:'\u0e17\u0e48\u0e32\u0e22\u0e37\u0e19\u0e02\u0e32\u0e40\u0e14\u0e35\u0e22\u0e27',japanese:'\u30b7\u30f3\u30b0\u30eb\u30ea\u30e0\u30b9\u30bf\u30f3\u30b9'},"Rock the Boat":{eng:'Rock the Boat',thai:'\u0e17\u0e48\u0e32\u0e04\u0e25\u0e37\u0e48\u0e19\u0e02\u0e32',japanese:'\u30dc\u30fc\u30c8\u3092\u63fa\u3089\u3059'},"Back Leg Raises":{eng:'Back Leg Raises',thai:'\u0e22\u0e01\u0e02\u0e32\u0e2b\u0e25\u0e31\u0e07',japanese:'\u30d0\u30c3\u30af\u30ec\u30c3\u30b0\u30ec\u30a4\u30ba'},"Side Leg Raise":{eng:'Side Leg Raise',thai:'\u0e22\u0e01\u0e02\u0e49\u0e32\u0e07',japanese:'\u30b5\u30a4\u30c9\u30ec\u30c3\u30b0\u30ec\u30a4\u30ba'},"Toe Lifts":{eng:'Toe Lifts',thai:'\u0e22\u0e01\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32',japanese:'\u30c8\u30fc\u30ea\u30d5\u30c8'},"Wall Pushups":{eng:'Wall Pushups',thai:'\u0e14\u0e31\u0e19\u0e1c\u0e19\u0e31\u0e07',japanese:'\u30a6\u30a9\u30fc\u30eb\u30d7\u30c3\u30b7\u30e5\u30a2\u30c3\u30d7'}}},days:{monday:{eng:'Monday',thai:'\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c',japanese:'\u6708\u66dc\u65e5'},wednesday:{eng:'Wednesday',thai:'\u0e27\u0e31\u0e19\u0e1e\u0e38\u0e18',japanese:'\u6c34\u66dc\u65e5'},friday:{eng:'Friday',thai:'\u0e27\u0e31\u0e19\u0e28\u0e38\u0e01\u0e23\u0e4c',japanese:'\u91d1\u66dc\u65e5'}},warmUp:{title:{eng:'Warm-Up',thai:'\u0e27\u0e2d\u0e23\u0e4c\u0e21\u0e2d\u0e31\u0e1e',japanese:'\u30a6\u30a9\u30fc\u30e0\u30a2\u30c3\u30d7'}},coolDown:{title:{eng:'Cool-Down Stretch',thai:'\u0e04\u0e25\u0e32\u0e22\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d',japanese:'\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u30b9\u30c8\u30ec\u30c3\u30c1'},instruction:{eng:'Hold each stretch for 30 seconds',thai:'\u0e22\u0e37\u0e14\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e25\u0e30 30 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35',japanese:'\u5404\u30b9\u30c8\u30ec\u30c3\u30c1\u309230\u79d2\u9593\u4fdd\u6301'},thighStretch:{eng:'Thigh Stretch: Sit and extend one leg, pull toes toward you',thai:'\u0e22\u0e37\u0e14\u0e15\u0e49\u0e19\u0e02\u0e32: \u0e19\u0e31\u0e48\u0e07\u0e40\u0e2b\u0e22\u0e35\u0e22\u0e14\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07 \u0e14\u0e36\u0e07\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32\u0e40\u0e02\u0e49\u0e32\u0e2b\u0e32',japanese:'\u592a\u3082\u3082\u306e\u30b9\u30c8\u30ec\u30c3\u30c1\uff1a\u5ea7\u3063\u3066\u7247\u8db3\u3092\u4f38\u3070\u3057\u3001\u3064\u307e\u5148\u3092\u81ea\u5206\u306e\u65b9\u306b\u5f15\u304f'},hamstringStretch:{eng:'Hamstring Stretch: Stand holding chair, extend leg behind and lean forward',thai:'\u0e22\u0e37\u0e14\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e25\u0e31\u0e07\u0e02\u0e32: \u0e08\u0e31\u0e1a\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49 \u0e40\u0e2b\u0e22\u0e35\u0e22\u0e14\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e07 \u0e42\u0e19\u0e49\u0e21\u0e15\u0e31\u0e27\u0e44\u0e1b\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e49\u0e32',japanese:'\u30cf\u30e0\u30b9\u30c8\u30ea\u30f3\u30b0\u30b9\u30c8\u30ec\u30c3\u30c1\uff1a\u6905\u5b50\u3092\u6301\u3063\u3066\u7acb\u3061\u3001\u8db3\u3092\u5f8c\u308d\u306b\u4f38\u3070\u3057\u3066\u524d\u50be'},calfStretch:{eng:'Calf Stretch: Face wall, step one leg back, bend front knee',thai:'\u0e22\u0e37\u0e14\u0e19\u0e48\u0e2d\u0e07: \u0e2b\u0e31\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e40\u0e02\u0e49\u0e32\u0e2b\u0e32\u0e1c\u0e19\u0e31\u0e07 \u0e16\u0e2d\u0e22\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e07 \u0e07\u0e2d\u0e40\u0e02\u0e48\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e49\u0e32',japanese:'\u3075\u304f\u3089\u306f\u304e\u30b9\u30c8\u30ec\u30c3\u30c1\uff1a\u58c1\u306b\u5411\u304b\u3044\u3001\u7247\u8db3\u3092\u5f8c\u308d\u306b\u4e0b\u3052\u3001\u524d\u819d\u3092\u66f2\u3052\u308b'},backStretch:{eng:'Back Stretch: Lie on back, hug knees to chest',thai:'\u0e22\u0e37\u0e14\u0e2b\u0e25\u0e31\u0e07: \u0e19\u0e2d\u0e19\u0e2b\u0e07\u0e32\u0e22 \u0e01\u0e2d\u0e14\u0e40\u0e02\u0e48\u0e32\u0e40\u0e02\u0e49\u0e32\u0e2b\u0e32\u0e2d\u0e01',japanese:'\u80cc\u4e2d\u306e\u30b9\u30c8\u30ec\u30c3\u30c1\uff1a\u4ef0\u5411\u3051\u306b\u5bdd\u3066\u3001\u819d\u3092\u80f8\u306b\u62b1\u3048\u308b'}},monday:{title:{eng:'Monday \u2013 Walking & Flexibility',thai:'\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c \u2013 \u0e40\u0e14\u0e34\u0e19\u0e41\u0e25\u0e30\u0e04\u0e27\u0e32\u0e21\u0e22\u0e37\u0e14\u0e2b\u0e22\u0e38\u0e48\u0e19',japanese:'\u6708\u66dc\u65e5 \u2013 \u30a6\u30a9\u30fc\u30ad\u30f3\u30b0\uff06\u67d4\u8edf\u6027'},warmUp:{title:{eng:'Warm-Up',thai:'\u0e27\u0e2d\u0e23\u0e4c\u0e21\u0e2d\u0e31\u0e1e',japanese:'\u6e96\u5099\u3057\u59cb\u3081\u308b'},slowWalk:{eng:'Slow Walk (2 min): Walk around your home at relaxed pace',thai:'\u0e40\u0e14\u0e34\u0e19\u0e0a\u0e49\u0e32 (2 \u0e19\u0e32\u0e17\u0e35): \u0e40\u0e14\u0e34\u0e19\u0e23\u0e2d\u0e1a\u0e1a\u0e49\u0e32\u0e19\u0e43\u0e19\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e2a\u0e1a\u0e32\u0e22\u0e46',japanese:'\u3086\u3063\u304f\u308a\u6b69\u304f\uff082\u5206\uff09\uff1a\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u305f\u30da\u30fc\u30b9\u3067\u5bb6\u306e\u5468\u308a\u3092\u6b69\u304f'},armCircles:{eng:'Arm Circles (2 min): Stand with feet shoulder-width apart, swing arms in circles',thai:'\u0e2b\u0e21\u0e38\u0e19\u0e41\u0e02\u0e19 (2 \u0e19\u0e32\u0e17\u0e35): \u0e22\u0e37\u0e19\u0e40\u0e17\u0e49\u0e32\u0e2b\u0e48\u0e32\u0e07\u0e40\u0e17\u0e48\u0e32\u0e44\u0e2b\u0e25\u0e48 \u0e2b\u0e21\u0e38\u0e19\u0e41\u0e02\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e27\u0e07\u0e01\u0e25\u0e21',japanese:'\u8155\u56de\u3057\uff082\u5206\uff09\uff1a\u8db3\u3092\u80a9\u5e45\u306b\u958b\u3044\u3066\u7acb\u3061\u3001\u8155\u3092\u5186\u3092\u63cf\u304f\u3088\u3046\u306b\u56de\u3059'},gentleStretch:{eng:'Gentle Stretch (1 min): Stretch arms, legs, and back. Hold each for 10 seconds',thai:'\u0e22\u0e37\u0e14\u0e40\u0e1a\u0e32\u0e46 (1 \u0e19\u0e32\u0e17\u0e35): \u0e22\u0e37\u0e14\u0e41\u0e02\u0e19 \u0e02\u0e32 \u0e41\u0e25\u0e30\u0e2b\u0e25\u0e31\u0e07 \u0e22\u0e37\u0e14\u0e25\u0e30 10 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35',japanese:'\u8efd\u3044\u30b9\u30c8\u30ec\u30c3\u30c1\uff081\u5206\uff09\uff1a\u8155\u3001\u811a\u3001\u80cc\u4e2d\u3092\u30b9\u30c8\u30ec\u30c3\u30c1\u3002\u540410\u79d2\u9593\u4fdd\u6301'}},walk:{title:{eng:'Walk',thai:'\u0e40\u0e14\u0e34\u0e19',japanese:'\u30a6\u30a9\u30fc\u30ad\u30f3\u30b0'},instruction:{eng:'Walk in a safe area (flat floor, park, hallway)',thai:'\u0e40\u0e14\u0e34\u0e19\u0e43\u0e19\u0e1e\u0e37\u0e49\u0e19\u0e17\u0e35\u0e48\u0e1b\u0e25\u0e2d\u0e14\u0e20\u0e31\u0e22 (\u0e1e\u0e37\u0e49\u0e19\u0e40\u0e23\u0e35\u0e22\u0e1a \u0e2a\u0e27\u0e19\u0e2a\u0e32\u0e18\u0e32\u0e23\u0e13\u0e30 \u0e17\u0e32\u0e07\u0e40\u0e14\u0e34\u0e19)',japanese:'\u5b89\u5168\u306a\u5834\u6240\u3092\u6b69\u304f\uff08\u5e73\u3089\u306a\u5e8a\u3001\u516c\u5712\u3001\u5eca\u4e0b\uff09'},pace:{eng:'Keep steady, comfortable pace\u2014you should still be able to talk',thai:'\u0e40\u0e14\u0e34\u0e19\u0e43\u0e19\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e2a\u0e21\u0e48\u0e33\u0e40\u0e2a\u0e21\u0e2d \u0e2a\u0e1a\u0e32\u0e22\u0e46 \u0e22\u0e31\u0e07\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e1e\u0e39\u0e14\u0e44\u0e14\u0e49',japanese:'\u4e00\u5b9a\u3067\u5feb\u9069\u306a\u30da\u30fc\u30b9\u3092\u4fdd\u3064\u2014\u307e\u3060\u8a71\u304c\u3067\u304d\u308b\u7a0b\u5ea6'},breaks:{eng:'Take breaks if needed',thai:'\u0e1e\u0e31\u0e01\u0e15\u0e32\u0e21\u0e04\u0e27\u0e32\u0e21\u0e08\u0e33\u0e40\u0e1b\u0e47\u0e19',japanese:'\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u4f11\u61a9\u3092\u53d6\u308b'}}},wednesday:{title:{eng:'Wednesday \u2013 Strength Training',thai:'\u0e27\u0e31\u0e19\u0e1e\u0e38\u0e18 \u2013 \u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e41\u0e23\u0e07',japanese:'\u6c34\u66dc\u65e5 \u2013 \u7b4b\u529b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0'},warmUp:{eng:'Same as Monday',thai:'\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c',japanese:'\u6708\u66dc\u65e5\u3068\u540c\u3058'},strength:{title:{eng:'Strength Exercises',thai:'\u0e41\u0e1a\u0e1a\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e41\u0e23\u0e07',japanese:'\u7b4b\u529b\u30a8\u30af\u30b5\u30b5\u30a4\u30ba'},seatedDeadBug:{eng:'Seated Arm & Leg Lifts: Sit straight, raise right arm and left leg together',thai:'\u0e22\u0e01\u0e41\u0e02\u0e19\u0e41\u0e25\u0e30\u0e02\u0e32\u0e02\u0e13\u0e30\u0e19\u0e31\u0e48\u0e07: \u0e19\u0e31\u0e48\u0e07\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e22\u0e01\u0e41\u0e02\u0e19\u0e02\u0e27\u0e32\u0e41\u0e25\u0e30\u0e02\u0e32\u0e0b\u0e49\u0e32\u0e22\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e01\u0e31\u0e19',japanese:'\u5ea7\u4f4d\u3067\u306e\u8155\u3068\u811a\u4e0a\u3052\uff1a\u771f\u3063\u76f4\u3050\u5ea7\u308a\u3001\u53f3\u8155\u3068\u5de6\u811a\u3092\u4e00\u7dd2\u306b\u4e0a\u3052\u308b'},seatedSideBends:{eng:'Seated Side Bends: Sit with one hand behind head, lean slowly to side',thai:'\u0e01\u0e49\u0e21\u0e02\u0e49\u0e32\u0e07\u0e02\u0e13\u0e30\u0e19\u0e31\u0e48\u0e07: \u0e19\u0e31\u0e48\u0e07\u0e43\u0e2a\u0e48\u0e21\u0e37\u0e2d\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e07\u0e2b\u0e31\u0e27 \u0e42\u0e19\u0e49\u0e21\u0e02\u0e49\u0e32\u0e07\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e0a\u0e49\u0e32\u0e46',japanese:'\u5ea7\u4f4d\u3067\u306e\u6a2a\u66f2\u3052\uff1a\u7247\u624b\u3092\u982d\u306e\u5f8c\u308d\u306b\u7f6e\u3044\u3066\u5ea7\u308a\u3001\u3086\u3063\u304f\u308a\u6a2a\u306b\u50be\u304f'},seatedForwardRollUps:{eng:'Seated Forward Roll-Ups: Sit with legs out, slowly roll upper body toward toes',thai:'\u0e21\u0e49\u0e27\u0e19\u0e15\u0e31\u0e27\u0e44\u0e1b\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e49\u0e32\u0e02\u0e13\u0e30\u0e19\u0e31\u0e48\u0e07: \u0e19\u0e31\u0e48\u0e07\u0e40\u0e2b\u0e22\u0e35\u0e22\u0e14\u0e02\u0e32 \u0e21\u0e49\u0e27\u0e19\u0e15\u0e31\u0e27\u0e2a\u0e48\u0e27\u0e19\u0e1a\u0e19\u0e44\u0e1b\u0e2b\u0e32\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32\u0e0a\u0e49\u0e32\u0e46',japanese:'\u5ea7\u4f4d\u3067\u306e\u524d\u5c48\u30ed\u30fc\u30eb\u30a2\u30c3\u30d7\uff1a\u811a\u3092\u4f38\u3070\u3057\u3066\u5ea7\u308a\u3001\u4e0a\u4f53\u3092\u3086\u3063\u304f\u308a\u3064\u307e\u5148\u306b\u5411\u3051\u3066\u4e38\u3081\u308b'},woodChops:{eng:'Standing Wood Chops: Hold hands together, swing from shoulder to opposite hip',thai:'\u0e17\u0e48\u0e32\u0e15\u0e31\u0e14\u0e44\u0e21\u0e49: \u0e1b\u0e23\u0e30\u0e2a\u0e32\u0e19\u0e21\u0e37\u0e2d \u0e27\u0e34\u0e07\u0e08\u0e32\u0e01\u0e44\u0e2b\u0e25\u0e48\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e2a\u0e30\u0e42\u0e1e\u0e01\u0e15\u0e23\u0e07\u0e02\u0e49\u0e32\u0e21',japanese:'\u7acb\u4f4d\u3067\u306e\u30a6\u30c3\u30c9\u30c1\u30e7\u30c3\u30d7\uff1a\u624b\u3092\u7d44\u307f\u3001\u80a9\u304b\u3089\u53cd\u5bfe\u5074\u306e\u8170\u3078\u30b9\u30a4\u30f3\u30b0'},wallPlank:{eng:'Wall Plank: Place forearms on wall, step back, keep body straight (15s hold \xd7 3)',thai:'\u0e41\u0e1e\u0e25\u0e07\u0e04\u0e4c\u0e1c\u0e19\u0e31\u0e07: \u0e27\u0e32\u0e07\u0e41\u0e02\u0e19\u0e17\u0e35\u0e48\u0e1c\u0e19\u0e31\u0e07 \u0e16\u0e2d\u0e22\u0e2b\u0e25\u0e31\u0e07 \u0e23\u0e31\u0e01\u0e29\u0e32\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 (\u0e01\u0e31\u0e49\u0e19 15 \u0e27\u0e34 \xd7 3)',japanese:'\u30a6\u30a9\u30fc\u30eb\u30d7\u30e9\u30f3\u30af\uff1a\u524d\u8155\u3092\u58c1\u306b\u7f6e\u304d\u3001\u5f8c\u308d\u306b\u4e0b\u304c\u308a\u3001\u4f53\u3092\u771f\u3063\u76f4\u3050\u4fdd\u3064\uff0815\u79d2\xd73\uff09'}}},friday:{title:{eng:'Friday \u2013 Balance Training',thai:'\u0e27\u0e31\u0e19\u0e28\u0e38\u0e01\u0e23\u0e4c \u2013 \u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e21\u0e14\u0e38\u0e25',japanese:'\u91d1\u66dc\u65e5 \u2013 \u30d0\u30e9\u30f3\u30b9\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0'},warmUp:{eng:'Same as Monday',thai:'\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c',japanese:'\u6708\u66dc\u65e5\u3068\u540c\u3058'},balance:{title:{eng:'Balance Exercises',thai:'\u0e41\u0e1a\u0e1a\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e21\u0e14\u0e38\u0e25',japanese:'\u30d0\u30e9\u30f3\u30b9\u30a8\u30af\u30b5\u30b5\u30a4\u30ba'},singleLimbStance:{eng:'One-Leg Stand: Stand behind chair, raise one leg and balance (15 sec)',thai:'\u0e22\u0e37\u0e19\u0e02\u0e32\u0e40\u0e14\u0e35\u0e22\u0e27: \u0e22\u0e37\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49 \u0e22\u0e01\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e41\u0e25\u0e30\u0e17\u0e23\u0e07\u0e15\u0e31\u0e27 (15 \u0e27\u0e34)',japanese:'\u7247\u8db3\u7acb\u3061\uff1a\u6905\u5b50\u306e\u5f8c\u308d\u306b\u7acb\u3061\u3001\u7247\u8db3\u3092\u4e0a\u3052\u3066\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\uff0815\u79d2\uff09'},rockTheBoat:{eng:'Rock the Boat: Stand with feet apart, shift weight and lift one foot (15 sec)',thai:'\u0e40\u0e02\u0e22\u0e48\u0e32\u0e40\u0e23\u0e37\u0e2d: \u0e22\u0e37\u0e19\u0e40\u0e17\u0e49\u0e32\u0e2b\u0e48\u0e32\u0e07 \u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e41\u0e25\u0e30\u0e22\u0e01\u0e40\u0e17\u0e49\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07 (15 \u0e27\u0e34)',japanese:'\u30ed\u30c3\u30af\u30fb\u30b6\u30fb\u30dc\u30fc\u30c8\uff1a\u8db3\u3092\u5e83\u3052\u3066\u7acb\u3061\u3001\u91cd\u5fc3\u3092\u79fb\u52d5\u3057\u3066\u7247\u8db3\u3092\u4e0a\u3052\u308b\uff0815\u79d2\uff09'},backLegRaises:{eng:'Back Leg Raises: Stand behind chair, lift one leg straight back, hold 1 sec',thai:'\u0e22\u0e01\u0e02\u0e32\u0e2b\u0e25\u0e31\u0e07: \u0e22\u0e37\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49 \u0e22\u0e01\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e15\u0e23\u0e07\u0e44\u0e1b\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e07 \u0e01\u0e31\u0e49\u0e19 1 \u0e27\u0e34',japanese:'\u30d0\u30c3\u30af\u30ec\u30c3\u30b0\u30ec\u30a4\u30ba\uff1a\u6905\u5b50\u306e\u5f8c\u308d\u306b\u7acb\u3061\u3001\u7247\u8db3\u3092\u771f\u3063\u76f4\u3050\u5f8c\u308d\u306b\u4e0a\u3052\u30011\u79d2\u4fdd\u6301'},sideLegRaises:{eng:'Side Leg Raises: Lift one leg out to the side, hold 1 sec, lower slowly',thai:'\u0e22\u0e01\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07: \u0e22\u0e01\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e44\u0e1b\u0e14\u0e49\u0e32\u0e19\u0e02\u0e49\u0e32\u0e07 \u0e01\u0e31\u0e49\u0e19 1 \u0e27\u0e34 \u0e25\u0e07\u0e0a\u0e49\u0e32\u0e46',japanese:'\u30b5\u30a4\u30c9\u30ec\u30c3\u30b0\u30ec\u30a4\u30ba\uff1a\u7247\u8db3\u3092\u6a2a\u306b\u4e0a\u3052\u30011\u79d2\u4fdd\u6301\u3001\u3086\u3063\u304f\u308a\u4e0b\u308d\u3059'},toeLifts:{eng:'Tiptoe Lifts: Stand tall, rise onto toes, hold 1 sec, lower slowly',thai:'\u0e22\u0e01\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32: \u0e22\u0e37\u0e19\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e22\u0e01\u0e02\u0e36\u0e49\u0e19\u0e1a\u0e19\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32 \u0e01\u0e31\u0e49\u0e19 1 \u0e27\u0e34 \u0e25\u0e07\u0e0a\u0e49\u0e32\u0e46',japanese:'\u3064\u307e\u5148\u7acb\u3061\uff1a\u771f\u3063\u76f4\u3050\u7acb\u3061\u3001\u3064\u307e\u5148\u3067\u7acb\u3061\u4e0a\u304c\u308a\u30011\u79d2\u4fdd\u6301\u3001\u3086\u3063\u304f\u308a\u4e0b\u308d\u3059'},wallPushUps:{eng:'Wall Push-Ups: Stand arm\'s length from wall, push toward wall, then back slowly',thai:'\u043e\u0442\u0436\u0438\u043c\u0430\u043d\u0438\u044f \u0e1c\u0e19\u0e31\u0e07: \u0e22\u0e37\u0e19\u0e2b\u0e48\u0e32\u0e07\u0e1c\u0e19\u0e31\u0e07\u0e40\u0e17\u0e48\u0e32\u0e04\u0e27\u0e32\u0e21\u0e22\u0e32\u0e27\u0e41\u0e02\u0e19 \u0e14\u0e31\u0e19\u0e40\u0e02\u0e49\u0e32\u0e2b\u0e32\u0e1c\u0e19\u0e31\u0e07 \u0e41\u0e25\u0e49\u0e27\u0e1c\u0e25\u0e31\u0e01\u0e01\u0e25\u0e31\u0e1a\u0e0a\u0e49\u0e32\u0e46',japanese:'\u30a6\u30a9\u30fc\u30eb\u30d7\u30c3\u30b7\u30e5\u30a2\u30c3\u30d7\uff1a\u58c1\u304b\u3089\u8155\u306e\u9577\u3055\u5206\u96e2\u308c\u3066\u7acb\u3061\u3001\u58c1\u306b\u5411\u304b\u3063\u3066\u62bc\u3057\u3001\u3086\u3063\u304f\u308a\u623b\u3059'}}},exerciseNotFound:{title:{eng:'Exercise Not Available',thai:'\u0e44\u0e21\u0e48\u0e21\u0e35\u0e01\u0e32\u0e23\u0e2d\u0e2d\u0e01\u0e01\u0e33\u0e25\u0e31\u0e07\u0e01\u0e32\u0e22\u0e19\u0e35\u0e49',japanese:'\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u304c\u5229\u7528\u3067\u304d\u307e\u305b\u3093'},message:{eng:'This exercise video is not available in our library yet.',thai:'\u0e27\u0e34\u0e14\u0e35\u0e42\u0e2d\u0e01\u0e32\u0e23\u0e2d\u0e2d\u0e01\u0e01\u0e33\u0e25\u0e31\u0e07\u0e01\u0e32\u0e22\u0e19\u0e35\u0e49\u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e21\u0e35\u0e43\u0e19\u0e2b\u0e49\u0e2d\u0e07\u0e2a\u0e21\u0e38\u0e14\u0e02\u0e2d\u0e07\u0e40\u0e23\u0e32',japanese:'\u3053\u306e\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u52d5\u753b\u306f\u307e\u3060\u30e9\u30a4\u30d6\u30e9\u30ea\u306b\u3042\u308a\u307e\u305b\u3093\u3002'}},mondayModerate:{title:{eng:'Monday \u2013 Walking & Stretching',thai:'\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c \u2013 \u0e40\u0e14\u0e34\u0e19\u0e41\u0e25\u0e30\u0e22\u0e37\u0e14\u0e40\u0e2a\u0e49\u0e19',japanese:'\u6708\u66dc\u65e5 \u2013 \u30a6\u30a9\u30fc\u30ad\u30f3\u30b0\uff06\u30b9\u30c8\u30ec\u30c3\u30c1\u30f3\u30b0'},warmUp:{slowWalk:{eng:'Slow Walk (2 min): Walk slowly around your home. Swing your arms and stand tall',thai:'\u0e40\u0e14\u0e34\u0e19\u0e0a\u0e49\u0e32 (2 \u0e19\u0e32\u0e17\u0e35): \u0e40\u0e14\u0e34\u0e19\u0e0a\u0e49\u0e32\u0e46 \u0e23\u0e2d\u0e1a\u0e1a\u0e49\u0e32\u0e19 \u0e41\u0e01\u0e27\u0e48\u0e07\u0e41\u0e02\u0e19\u0e41\u0e25\u0e30\u0e22\u0e37\u0e19\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07',japanese:'\u3086\u3063\u304f\u308a\u6b69\u304f\uff082\u5206\uff09\uff1a\u5bb6\u306e\u5468\u308a\u3092\u3086\u3063\u304f\u308a\u6b69\u304f\u3002\u8155\u3092\u632f\u3063\u3066\u80cc\u7b4b\u3092\u4f38\u3070\u3059'},armCircles:{eng:'Arm Circles (2 min): Stand tall. Move arms in big circles forward and backward',thai:'\u0e2b\u0e21\u0e38\u0e19\u0e41\u0e02\u0e19 (2 \u0e19\u0e32\u0e17\u0e35): \u0e22\u0e37\u0e19\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e2b\u0e21\u0e38\u0e19\u0e41\u0e02\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e27\u0e07\u0e01\u0e25\u0e21\u0e43\u0e2b\u0e0d\u0e48\u0e44\u0e1b\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e49\u0e32\u0e41\u0e25\u0e30\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e07',japanese:'\u8155\u56de\u3057\uff082\u5206\uff09\uff1a\u771f\u3063\u76f4\u3050\u7acb\u3064\u3002\u8155\u3092\u5927\u304d\u304f\u5186\u3092\u63cf\u304f\u3088\u3046\u306b\u524d\u5f8c\u306b\u52d5\u304b\u3059'},lightStretch:{eng:'Light Stretch (1 min): Gently stretch your arms, legs, and back. Hold each for 10 seconds',thai:'\u0e22\u0e37\u0e14\u0e40\u0e1a\u0e32\u0e46 (1 \u0e19\u0e32\u0e17\u0e35): \u0e22\u0e37\u0e14\u0e41\u0e02\u0e19 \u0e02\u0e32 \u0e41\u0e25\u0e30\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e1a\u0e32\u0e46 \u0e22\u0e37\u0e14\u0e25\u0e30 10 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35',japanese:'\u8efd\u3044\u30b9\u30c8\u30ec\u30c3\u30c1\uff081\u5206\uff09\uff1a\u8155\u3001\u811a\u3001\u80cc\u4e2d\u3092\u8efd\u304f\u30b9\u30c8\u30ec\u30c3\u30c1\u3002\u540410\u79d2\u9593\u4fdd\u6301'}},walk:{title:{eng:'Walk',thai:'\u0e40\u0e14\u0e34\u0e19',japanese:'\u30a6\u30a9\u30fc\u30ad\u30f3\u30b0'},instruction:{eng:'Walk indoors or in a safe outdoor area with a flat surface',thai:'\u0e40\u0e14\u0e34\u0e19\u0e43\u0e19\u0e1a\u0e49\u0e32\u0e19\u0e2b\u0e23\u0e37\u0e2d\u0e43\u0e19\u0e1e\u0e37\u0e49\u0e19\u0e17\u0e35\u0e48\u0e01\u0e25\u0e32\u0e07\u0e41\u0e08\u0e49\u0e07\u0e17\u0e35\u0e48\u0e1b\u0e25\u0e2d\u0e14\u0e20\u0e31\u0e22\u0e41\u0e25\u0e30\u0e40\u0e1b\u0e47\u0e19\u0e1e\u0e37\u0e49\u0e19\u0e40\u0e23\u0e35\u0e22\u0e1a',japanese:'\u5c4b\u5185\u307e\u305f\u306f\u5e73\u3089\u3067\u5b89\u5168\u306a\u5c4b\u5916\u30a8\u30ea\u30a2\u3092\u6b69\u304f'},pace:{eng:'Walk at a steady pace where you can still talk comfortably',thai:'\u0e40\u0e14\u0e34\u0e19\u0e43\u0e19\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e2a\u0e21\u0e48\u0e33\u0e40\u0e2a\u0e21\u0e2d\u0e17\u0e35\u0e48\u0e22\u0e31\u0e07\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e1e\u0e39\u0e14\u0e44\u0e14\u0e49\u0e2a\u0e1a\u0e32\u0e22',japanese:'\u5feb\u9069\u306b\u8a71\u305b\u308b\u30da\u30fc\u30b9\u3067\u4e00\u5b9a\u306b\u6b69\u304f'},rest:{eng:'Rest if you get tired',thai:'\u0e1e\u0e31\u0e01\u0e2b\u0e32\u0e01\u0e04\u0e38\u0e13\u0e40\u0e2b\u0e19\u0e37\u0e48\u0e2d\u0e22',japanese:'\u75b2\u308c\u305f\u3089\u4f11\u3080'}}},wednesdayModerate:{title:{eng:'Wednesday \u2013 Strength Training (Chair Exercises)',thai:'\u0e27\u0e31\u0e19\u0e1e\u0e38\u0e18 \u2013 \u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e41\u0e23\u0e07 (\u0e41\u0e1a\u0e1a\u0e1d\u0e36\u0e01\u0e1a\u0e19\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49)',japanese:'\u6c34\u66dc\u65e5 \u2013 \u7b4b\u529b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\uff08\u6905\u5b50\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\uff09'},warmUp:{eng:'Same as Monday',thai:'\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c',japanese:'\u6708\u66dc\u65e5\u3068\u540c\u3058'},strength:{title:{eng:'Strength Exercises',thai:'\u0e41\u0e1a\u0e1a\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e41\u0e23\u0e07',japanese:'\u7b4b\u529b\u30a8\u30af\u30b5\u30b5\u30a4\u30ba'},seatedDeadBug:{eng:'Sit back straight on a sturdy chair. Lift right arm + left leg together. Hold for 3 sec',thai:'\u0e19\u0e31\u0e48\u0e07\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07\u0e1a\u0e19\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49\u0e21\u0e31\u0e48\u0e19\u0e04\u0e07 \u0e22\u0e01\u0e41\u0e02\u0e19\u0e02\u0e27\u0e32 + \u0e02\u0e32\u0e0b\u0e49\u0e32\u0e22\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e01\u0e31\u0e19 \u0e01\u0e31\u0e49\u0e19 3 \u0e27\u0e34',japanese:'\u9811\u4e08\u306a\u6905\u5b50\u306b\u771f\u3063\u76f4\u3050\u5ea7\u308b\u3002\u53f3\u8155+\u5de6\u811a\u3092\u540c\u6642\u306b\u4e0a\u3052\u30013\u79d2\u4fdd\u6301'},seatedSideBends:{eng:'Sit with feet flat. One hand behind your head. Lean to side slowly and return',thai:'\u0e19\u0e31\u0e48\u0e07\u0e40\u0e17\u0e49\u0e32\u0e40\u0e23\u0e35\u0e22\u0e1a \u0e21\u0e37\u0e2d\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e2d\u0e22\u0e39\u0e48\u0e2b\u0e25\u0e31\u0e07\u0e2b\u0e31\u0e27 \u0e42\u0e19\u0e49\u0e21\u0e02\u0e49\u0e32\u0e07\u0e0a\u0e49\u0e32\u0e46 \u0e41\u0e25\u0e49\u0e27\u0e01\u0e25\u0e31\u0e1a',japanese:'\u8db3\u3092\u5e73\u3089\u306b\u3057\u3066\u5ea7\u308b\u3002\u7247\u624b\u3092\u982d\u306e\u5f8c\u308d\u306b\u3002\u3086\u3063\u304f\u308a\u6a2a\u306b\u50be\u3044\u3066\u623b\u308b'},seatedForwardRoll:{eng:'Sit tall, legs out straight, arms forward. Tuck chin and slowly roll toward toes',thai:'\u0e19\u0e31\u0e48\u0e07\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e40\u0e2b\u0e22\u0e35\u0e22\u0e14\u0e02\u0e32 \u0e41\u0e02\u0e19\u0e22\u0e37\u0e48\u0e19\u0e44\u0e1b\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e49\u0e32 \u0e01\u0e49\u0e21\u0e04\u0e32\u0e07\u0e41\u0e25\u0e30\u0e21\u0e49\u0e27\u0e19\u0e15\u0e31\u0e27\u0e44\u0e1b\u0e2b\u0e32\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32\u0e0a\u0e49\u0e32\u0e46',japanese:'\u80cc\u7b4b\u3092\u4f38\u3070\u3057\u3066\u5ea7\u308a\u3001\u811a\u3092\u4f38\u3070\u3057\u3001\u8155\u3092\u524d\u306b\u3002\u3042\u3054\u3092\u5f15\u3044\u3066\u3086\u3063\u304f\u308a\u3064\u307e\u5148\u306b\u5411\u304b\u3063\u3066\u4e38\u3081\u308b'},woodChops:{eng:'Hold a bottle with both hands. Swing from above one shoulder down to opposite hip',thai:'\u0e16\u0e37\u0e2d\u0e02\u0e27\u0e14\u0e14\u0e49\u0e27\u0e22\u0e21\u0e37\u0e2d\u0e17\u0e31\u0e49\u0e07\u0e2a\u0e2d\u0e07 \u0e27\u0e34\u0e07\u0e08\u0e32\u0e01\u0e40\u0e2b\u0e19\u0e37\u0e2d\u0e44\u0e2b\u0e25\u0e48\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e25\u0e07\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e2a\u0e30\u0e42\u0e1e\u0e01\u0e15\u0e23\u0e07\u0e02\u0e49\u0e32\u0e21',japanese:'\u4e21\u624b\u3067\u30dc\u30c8\u30eb\u3092\u6301\u3064\u3002\u7247\u65b9\u306e\u80a9\u306e\u4e0a\u304b\u3089\u53cd\u5bfe\u5074\u306e\u8170\u306b\u5411\u304b\u3063\u3066\u30b9\u30a4\u30f3\u30b0'},wallPlank:{eng:'Place forearms on wall, step back slightly. Keep body straight. Hold for 10 seconds',thai:'\u0e27\u0e32\u0e07\u0e41\u0e02\u0e19\u0e17\u0e35\u0e48\u0e1c\u0e19\u0e31\u0e07 \u0e16\u0e2d\u0e22\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e25\u0e47\u0e01\u0e19\u0e49\u0e2d\u0e22 \u0e23\u0e31\u0e01\u0e29\u0e32\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e01\u0e31\u0e49\u0e19 10 \u0e27\u0e34',japanese:'\u524d\u8155\u3092\u58c1\u306b\u7f6e\u304d\u3001\u5c11\u3057\u5f8c\u308d\u306b\u4e0b\u304c\u308b\u3002\u4f53\u3092\u307e\u3063\u3059\u3050\u4fdd\u3061\u300110\u79d2\u9593\u4fdd\u6301'}}},fridayModerate:{title:{eng:'Friday \u2013 Balance Training',thai:'\u0e27\u0e31\u0e19\u0e28\u0e38\u0e01\u0e23\u0e4c \u2013 \u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e21\u0e14\u0e38\u0e25',japanese:'\u91d1\u66dc\u65e5 \u2013 \u30d0\u30e9\u30f3\u30b9\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0'},warmUp:{eng:'Same as Monday',thai:'\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e27\u0e31\u0e19\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c',japanese:'\u6708\u66dc\u65e5\u3068\u540c\u3058'},balance:{title:{eng:'Balance Exercises',thai:'\u0e41\u0e1a\u0e1a\u0e1d\u0e36\u0e01\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e21\u0e14\u0e38\u0e25',japanese:'\u30d0\u30e9\u30f3\u30b9\u30a8\u30af\u30b5\u30b5\u30a4\u30ba'},oneLegStand:{eng:'Hold a sturdy chair. Lift one foot and balance. Hold for 10 sec. Switch legs',thai:'\u0e08\u0e31\u0e1a\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49\u0e21\u0e31\u0e48\u0e19\u0e04\u0e07 \u0e22\u0e01\u0e40\u0e17\u0e49\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e41\u0e25\u0e30\u0e17\u0e23\u0e07\u0e15\u0e31\u0e27 \u0e01\u0e31\u0e49\u0e19 10 \u0e27\u0e34 \u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e02\u0e32',japanese:'\u9811\u4e08\u306a\u6905\u5b50\u3092\u6301\u3064\u3002\u7247\u8db3\u3092\u4e0a\u3052\u3066\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u300210\u79d2\u4fdd\u6301\u3002\u811a\u3092\u5909\u3048\u308b'},rockTheBoat:{eng:'Stand tall. Shift weight to one leg and lift the other. Hold for a few seconds',thai:'\u0e22\u0e37\u0e19\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e44\u0e1b\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e41\u0e25\u0e30\u0e22\u0e01\u0e2d\u0e35\u0e01\u0e02\u0e49\u0e32\u0e07 \u0e01\u0e31\u0e49\u0e19\u0e2a\u0e31\u0e01\u0e04\u0e23\u0e39\u0e48',japanese:'\u771f\u3063\u76f4\u3050\u7acb\u3064\u3002\u91cd\u5fc3\u3092\u7247\u8db3\u306b\u79fb\u3057\u3001\u3082\u3046\u7247\u65b9\u3092\u4e0a\u3052\u308b\u3002\u6570\u79d2\u9593\u4fdd\u6301'},backLegRaises:{eng:'Stand behind a chair. Lift one leg straight behind. Hold 1 sec. Lower slowly',thai:'\u0e22\u0e37\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e01\u0e49\u0e32\u0e2d\u0e35\u0e49 \u0e22\u0e01\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e15\u0e23\u0e07\u0e44\u0e1b\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e07 \u0e01\u0e31\u0e49\u0e19 1 \u0e27\u0e34 \u0e25\u0e07\u0e0a\u0e49\u0e32\u0e46',japanese:'\u6905\u5b50\u306e\u5f8c\u308d\u306b\u7acb\u3064\u3002\u7247\u8db3\u3092\u771f\u3063\u76f4\u3050\u5f8c\u308d\u306b\u4e0a\u3052\u308b\u30021\u79d2\u4fdd\u6301\u3002\u3086\u3063\u304f\u308a\u4e0b\u308d\u3059'},sideLegRaises:{eng:'Lift one leg out to the side. Keep back straight. Hold 1 sec. Lower slowly',thai:'\u0e22\u0e01\u0e02\u0e32\u0e02\u0e49\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e44\u0e1b\u0e14\u0e49\u0e32\u0e19\u0e02\u0e49\u0e32\u0e07 \u0e23\u0e31\u0e01\u0e29\u0e32\u0e2b\u0e25\u0e31\u0e07\u0e15\u0e23\u0e07 \u0e01\u0e31\u0e49\u0e19 1 \u0e27\u0e34 \u0e25\u0e07\u0e0a\u0e49\u0e32\u0e46',japanese:'\u7247\u8db3\u3092\u6a2a\u306b\u4e0a\u3052\u308b\u3002\u80cc\u4e2d\u3092\u307e\u3063\u3059\u3050\u4fdd\u3064\u30021\u79d2\u4fdd\u6301\u3002\u3086\u3063\u304f\u308a\u4e0b\u308d\u3059'},tiptoeLifts:{eng:'Stand tall, raise up on toes, hold 1 sec, then lower slowly',thai:'\u0e22\u0e37\u0e19\u0e15\u0e31\u0e27\u0e15\u0e23\u0e07 \u0e22\u0e01\u0e02\u0e36\u0e49\u0e19\u0e1a\u0e19\u0e19\u0e34\u0e49\u0e27\u0e40\u0e17\u0e49\u0e32 \u0e01\u0e31\u0e49\u0e19 1 \u0e27\u0e34 \u0e41\u0e25\u0e49\u0e27\u0e25\u0e07\u0e0a\u0e49\u0e32\u0e46',japanese:'\u771f\u3063\u76f4\u3050\u7acb\u3061\u3001\u3064\u307e\u5148\u7acb\u3061\u306b\u306a\u308a\u30011\u79d2\u4fdd\u6301\u3001\u3086\u3063\u304f\u308a\u4e0b\u308d\u3059'},wallPushUps:{eng:'Stand arm\'s length from wall. Hands on wall, lean in, then push back',thai:'\u0e22\u0e37\u0e19\u0e2b\u0e48\u0e32\u0e07\u0e1c\u0e19\u0e31\u0e07\u0e40\u0e17\u0e48\u0e32\u0e04\u0e27\u0e32\u0e21\u0e22\u0e32\u0e27\u0e41\u0e02\u0e19 \u0e21\u0e37\u0e2d\u0e1a\u0e19\u0e1c\u0e19\u0e31\u0e07 \u0e40\u0e2d\u0e19\u0e40\u0e02\u0e49\u0e32 \u0e41\u0e25\u0e49\u0e27\u0e1c\u0e25\u0e31\u0e01\u0e01\u0e25\u0e31\u0e1a',japanese:'\u58c1\u304b\u3089\u8155\u306e\u9577\u3055\u5206\u96e2\u308c\u3066\u7acb\u3064\u3002\u624b\u3092\u58c1\u306b\u3001\u5bc4\u308a\u304b\u304b\u308a\u3001\u62bc\u3057\u623b\u3059'}}}}},1559,[]);

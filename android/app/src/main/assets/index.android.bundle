ion.</p>\n            \n              <p style=\"text-align:justify;font-size:10.6px;\"><strong>By signing this form,</strong></p>\n              <p style=\"text-align:justify;font-size:10.6px;\">I understand that all the laws that are protecting my privacy of medical history or information are also applied to telemedicine practices.</p>\n              <p style=\"text-align:justify;font-size:10.6px;\">I understand that I can withdraw the consent at any time and that will not affect any of my future treatment procedures.</p>\n              <p style=\"text-align:justify;font-size:10.6px;\">I understand that I can be charged the additional fees that my insurance does not cover.</p>\n              <p style=\"text-align:justify;font-size:10.6px;\">I accept that I authorize&nbsp;health care professionals and use telemedicine for my treatment and diagnosis.</p>\n         \n          </div>",editorInitializedCallback:()=>this.onEditorInitialized()})})})]}),(0,x.jsxs)(l.TouchableOpacity,{onPress:e=>{this.setState({agreeBox:!t})},style:{flexDirection:'row',margin:20,left:5,top:10},children:[(0,x.jsx)(c.default,{disabled:!1,value:t,onValueChange:e=>this.setState({agreeBox:e})}),(0,x.jsx)(l.Text,{style:{paddingTop:5},children:" I have read and agree to the terms"})]}),n&&(0,x.jsx)(l.Text,{style:{fontSize:12,marginLeft:20,left:20,color:'red'},children:"Please agree to the terms "}),(0,x.jsxs)(l.View,{style:{flex:1,flexDirection:'row',justifyContent:'center',marginTop:10},children:[(0,x.jsx)(u.default,{onPress:e=>{console.log('s'),t?this.props.navigation.navigate('Register'):this.setState({showError:!0})},styles:{width:140},title:"Agree",bgColor:f.default.color_green}),(0,x.jsx)(u.default,{onPress:e=>{console.log('Pros',this.props),this.props.navigation.navigate('SignIn')},styles:{width:140},title:"Disagree",bgColor:f.default.color_orange})]})]})})}}])})(r.Component));_e.default=(0,_r(d[19]).connect)(e=>({lang:e.lang}),e=>({addUser:t=>e({type:'ADD_USERINFO',payload:t}),edit_Lang:
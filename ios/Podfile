# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions v5
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end
node_require('react-native-permissions/scripts/setup.rb')

# Some older libraries (e.g. react-native-image-picker 7.x) still depend on RCT-Folly,
# which only exists when React Native deps are built from source.
ENV['RCT_USE_RN_DEP'] ||= '0'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Bluetooth',
  'Camera',
  'LocationWhenInUse',
  'Microphone',
  'Notifications',
  'PhotoLibrary',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SurasoleMedicalApp' do
  config = use_native_modules!

  # Firebase (used by @react-native-firebase) without use_frameworks!
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseSharedSwift', :modular_headers => true
  pod 'leveldb-library', :modular_headers => true

  # react-native-image-crop-picker 0.40.x uses TOCropViewController 2.x APIs (customAspectRatio); 3.x removed them.
  pod 'TOCropViewController', '~> 2.7.4'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'SurasoleMedicalAppTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # fmt 11.x consteval breaks with Xcode 26 clang when its headers are included from C++20 pods
    # (e.g. NitroModules). Disable consteval in fmt's base.h after every pod install.
    fmt_base = File.join(installer.sandbox.root.to_s, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      src = File.read(fmt_base)
      patched = src.gsub("#  define FMT_USE_CONSTEVAL 1", "#  define FMT_USE_CONSTEVAL 0")
      if patched != src
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
      end
    end

    # fmt 11.x fails with Xcode 26 clang in C++20 (consteval errors); build it as C++17.
    installer.pods_project.targets.each do |t|
      if t.name == 'fmt'
        t.build_configurations.each do |c|
          c.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
